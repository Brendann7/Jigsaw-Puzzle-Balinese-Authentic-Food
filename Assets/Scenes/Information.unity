  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mujair Nyat-Nyat is an iconic culinary specialty originating from the
    breathtaking highland region of Kintamani in Bali. The dish exclusively uses
    fresh tilapia (mujair) harvested straight from the pristine waters of Lake Batur.
    The cooking process involves simmering the fish with bumbu genep\u2014the signature
    traditional Balinese rich spice paste containing a complex blend of aromatic
    herbs and spices\u2014until the cooking liquid completely reduces, a local technique
    known as nyat-nyat. This allows the potent spices to absorb deeply into every
    fiber of the fish, resulting in a rich, spicy, and deeply savory taste that is
    exceptionally satisfying when enjoyed alongside a plate of warm steamed rice.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 48a8c59fe7748cc4fa84177fbb4956a1, type: 2}
  m_sharedMaterial: {fileID: 8399879538989277976, guid: 48a8c59fe7748cc4fa84177fbb4956a1, type: 2}
